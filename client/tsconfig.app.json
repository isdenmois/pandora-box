{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "**/*", "**/*.vue"],
  "exclude": ["**/__tests__/*"],
  "compilerOptions": {
    "types": ["bun-types"],
    "lib": ["ES2022", "ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/server/*": ["../server/domain"],
      "@server/*": ["../server/*"],
      "@/*": ["./*"]
    }
  }
}
