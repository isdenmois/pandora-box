{
  "name": "pandora-box",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || echo 'Not in a git repo'",
    "dev": "vite dev",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "bun check -p server/tsconfig.json",
    "typecheck:client": "bunx --bun vue-tsc -p client/tsconfig.app.json --noEmit --incremental",
    "typecheck:perf": "bunx --bun vue-tsc -p client/tsconfig.app.json --noEmit --extendedDiagnostics",
    "test:client": "vitest --run",
    "test:server": "bunx --bun vitest --run --config vitest.config.server.ts",
    "test:unit": "npm run test:client && npm run test:server",
    "test:pw": "playwright test",
    "perf:series": "bun server/perf/series.bench.ts",
    "perf:idle": "bun server/perf/idle.bench.ts",
    "test": "npm run test:unit && npm run test:pw",
    "server": "bun run --watch server/index.ts",
    "server:build": "bun build server/index.ts --target bun --outdir ./build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.12",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node26": "26.0.2",
    "@types/jsdom": "30.0.0",
    "@unocss/preset-wind4": "66.13.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/browser": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "bun-types": "1.4.4",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "playwright": "1.65.1",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "hono": "4.13.19",
    "pinia": "4.1.0",
    "unocss": "66.13.0",
    "valibot": "1.5.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vue-standard-schema": "4.0.2",
    "wretch": "3.0.9"
  }
}
