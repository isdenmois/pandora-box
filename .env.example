DATABASE_URL=local.db
OMDB_URL=
# Where downloaded posters are stored; must be readable by nginx in production.
IMAGE_DIR=data/images
# Max size of a single poster in bytes.
IMAGE_MAX_BYTES=5242880
# `off` disables downloads; cold misses redirect to the remote source instead.
IMAGE_FETCH=on

# Offsite backup, all three optional: without them the endpoints answer 503.
# Realtime Database URL of the Firebase project.
# FIREBASE_DB_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
# Service-account JSON, base64-encoded so the PEM newlines survive `.env`:
#   base64 -w0 serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_B64=
# Bearer token the cron sends; at least 16 characters.
# BACKUP_TOKEN=
